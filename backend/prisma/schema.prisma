generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrowdLevel {
  LOW
  MEDIUM
  HIGH
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum BusStatus {
  IN_SERVICE
  RESERVE
}

enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum Role {
  PASSENGER
  OPERATOR
}

model User {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  passwordHash  String
  role          Role             @default(PASSENGER)
  // Blocked passengers can still sign in but cannot send crowd reports
  blocked       Boolean          @default(false)
  createdAt     DateTime         @default(now())
  reports       CrowdReport[]
  dispatches    DispatchAction[]
  announcements Announcement[]
}

model Route {
  id            Int               @id @default(autoincrement())
  number        String            @unique
  name          String
  color         String
  lengthM       Float
  // Ordered polyline [[lat, lng], ...] the buses drive along
  path          Json
  createdAt     DateTime          @default(now())
  stops         RouteStop[]
  buses         Bus[]
  reports       CrowdReport[]
  snapshots     DensitySnapshot[]
  alerts        Alert[]
  dispatchesIn  DispatchAction[]  @relation("dispatchTo")
  dispatchesOut DispatchAction[]  @relation("dispatchFrom")
  announcements Announcement[]
}

model Stop {
  id      Int           @id @default(autoincrement())
  name    String        @unique
  lat     Float
  lng     Float
  routes  RouteStop[]
  reports CrowdReport[]
}

model RouteStop {
  id        Int   @id @default(autoincrement())
  routeId   Int
  stopId    Int
  order     Int
  // Distance from the start of the route polyline, in metres
  distanceM Float
  route     Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop      Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, order])
  @@unique([routeId, stopId])
}

model Bus {
  id         Int              @id @default(autoincrement())
  plate      String           @unique
  // null while the bus waits in the depot as a reserve
  routeId    Int?
  status     BusStatus        @default(IN_SERVICE)
  capacity   Int              @default(90)
  lat        Float
  lng        Float
  // Position along the route polyline in metres, and travel direction (1 forward, -1 back)
  progressM  Float            @default(0)
  direction  Int              @default(1)
  speedKmh   Float            @default(0)
  // Simulated on-board passenger count (sensor / validator data)
  occupancy  Int              @default(0)
  updatedAt  DateTime         @updatedAt
  route      Route?           @relation(fields: [routeId], references: [id], onDelete: SetNull)
  pings      GpsPing[]
  reports    CrowdReport[]
  dispatches DispatchAction[]
}

model GpsPing {
  id        Int      @id @default(autoincrement())
  busId     Int
  lat       Float
  lng       Float
  speedKmh  Float
  occupancy Int
  createdAt DateTime @default(now())
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([busId, createdAt])
}

model CrowdReport {
  id        Int        @id @default(autoincrement())
  routeId   Int
  busId     Int?
  stopId    Int?
  level     CrowdLevel
  clientId  String?
  userId    Int?
  // Moderated reports are kept for audit but ignored by the analytics engine
  flagged   Boolean    @default(false)
  createdAt DateTime   @default(now())
  route     Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bus       Bus?       @relation(fields: [busId], references: [id], onDelete: SetNull)
  stop      Stop?      @relation(fields: [stopId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([routeId, createdAt])
  @@index([userId, routeId, createdAt])
}

model DensitySnapshot {
  id           Int        @id @default(autoincrement())
  routeId      Int
  score        Float
  level        CrowdLevel
  reportCount  Int
  avgOccupancy Float
  createdAt    DateTime   @default(now())
  route        Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, createdAt])
}

model Alert {
  id             Int         @id @default(autoincrement())
  routeId        Int
  type           String      @default("EXTRA_BUS_NEEDED")
  message        String
  status         AlertStatus @default(OPEN)
  details        Json?
  createdAt      DateTime    @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  route          Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, status])
}

// Operator actions on the fleet: reserve dispatch, rebalancing between routes, return to depot
model DispatchAction {
  id          Int      @id @default(autoincrement())
  type        String
  busId       Int
  fromRouteId Int?
  toRouteId   Int?
  operatorId  Int?
  note        String?
  createdAt   DateTime @default(now())
  bus         Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  fromRoute   Route?   @relation("dispatchFrom", fields: [fromRouteId], references: [id], onDelete: SetNull)
  toRoute     Route?   @relation("dispatchTo", fields: [toRouteId], references: [id], onDelete: SetNull)
  operator    User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([toRouteId, createdAt])
}

// Service notices shown live to passengers (routeId null = all routes)
model Announcement {
  id          Int       @id @default(autoincrement())
  routeId     Int?
  message     String
  severity    Severity  @default(INFO)
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdById Int?
  createdAt   DateTime  @default(now())
  route       Route?    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
}

// Runtime-editable engine settings (alert rule thresholds etc.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
